{
  "name": "floatnote",
  "version": "2.1.0",
  "description": "Always-on-top to-do list: Today, Next, Waiting, Later, a morning pick, hotkey capture, sync, and a drop folder for Claude",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/danieljpuusitalo/FloatNote.git"
  },
  "homepage": "https://github.com/danieljpuusitalo/FloatNote",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build": "electron-builder --win --x64 && electron-builder --win --arm64",
    "build:x64": "electron-builder --win --x64",
    "build:arm64": "electron-builder --win --arm64",
    "install-skill": "node -e \"const fs=require('fs'),path=require('path'),d=path.join(require('os').homedir(),'.claude','skills','floatnote');fs.mkdirSync(d,{recursive:true});fs.copyFileSync('skills/floatnote/SKILL.md',path.join(d,'SKILL.md'));console.log('installed to '+d)\""
  },
  "keywords": [
    "electron",
    "desktop",
    "to-do",
    "productivity",
    "floating",
    "gtd",
    "habit-tracker"
  ],
  "author": "Daniel J Puusitalo",
  "license": "MIT",
  "type": "commonjs",
  "build": {
    "appId": "com.floatnote.app",
    "productName": "FloatNote",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "${productName} Setup ${version}-${arch}.${ext}"
    },
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "core.js",
      "sync.js",
      "package.json",
      "build/**"
    ]
  },
  "devDependencies": {
    "electron": "^40.4.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "firebase": "^12.10.0"
  }
}
